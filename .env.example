# Alpaca paper-trading API (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LLM provider keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HF_API_TOKEN=

# Cloudflare Workers AI — free fallback for the sentiment leg, used when the
# Hugging Face credit balance is spent (which returns 402 for every HF model at
# once). Token needs only Account > Workers AI > Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# DeepSeek via the local deeperseeker proxy — primary analyst/exit-analyst leg
# when USE_DEEPSEEK=1, falling back to agy, then the Gemini API. The key is the
# proxy's own DEEPSEEKER_API_KEY (note the different name). The proxy fronts a
# throwaway DeepSeek web account: expect bans and token expiry.
USE_DEEPSEEK=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=http://127.0.0.1:4000/v1
DEEPSEEK_MODEL=v4.1flash
DEEPSEEK_TIMEOUT=75

# Optional tuning (defaults shown)
STOP_LOSS_PCT=5
POSITION_SIZE_PCT=2
MAX_POSITIONS=8
CASH_RESERVE_USD=500
MIN_TRADE_USD=750
TICKER_BATCH_SIZE=10

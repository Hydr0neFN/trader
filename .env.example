# Alpaca paper-trading API (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LLM provider keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HF_API_TOKEN=

# Cloudflare Workers AI — free fallback for the sentiment leg, used when the
# Hugging Face credit balance is spent (which returns 402 for every HF model at
# once). Token needs only Account > Workers AI > Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional tuning (defaults shown)
STOP_LOSS_PCT=5
POSITION_SIZE_PCT=2
MAX_POSITIONS=8
CASH_RESERVE_USD=500
MIN_TRADE_USD=750
TICKER_BATCH_SIZE=10
